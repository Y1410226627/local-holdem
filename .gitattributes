# 统一换行符
# - Windows 批处理 / PowerShell 保持 CRLF
# - macOS / Linux 脚本必须是 LF（CRLF 会导致 bash 报错）
* text=auto
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sh text eol=lf
android/gradlew text eol=lf
*.command text eol=lf

# 二进制文件
*.apk binary
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
