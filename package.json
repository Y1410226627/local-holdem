{
  "name": "local-holdem",
  "private": true,
  "version": "0.23.0",
  "description": "本地人机无限注德州扑克：纯前端规则引擎 + 本地算法 AI，零网络、零付费服务",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "train": "tsx scripts/train.ts",
    "train:quick": "tsx scripts/train.ts --quick",
    "sync:data": "node scripts/sync-data.mjs",
    "gto:tables": "tsx scripts/generate-gto-tables.ts",
    "apk": "node scripts/build-apk.mjs",
    "apk:debug": "node scripts/build-apk.mjs --debug",
    "bench": "tsx scripts/bench-ai.ts",
    "gto:equity": "tsx scripts/generate-preflop-equity.ts",
    "gto:blueprint": "tsx scripts/generate-preflop-blueprint.ts",
    "audit:exploit": "tsx scripts/audit-exploit.ts",
    "exe": "npm run build && electron-builder --win nsis",
    "exe:portable": "npm run build && electron-builder --win portable",
    "single": "node scripts/build-single.mjs",
    "sweep:preflop": "tsx scripts/sweep-preflop.ts",
    "shot:mobile": "node scripts/shot-mobile.cjs",
    "play:human": "tsx scripts/play-as-human.ts"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/core": "^7.6.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  },
  "main": "electron/main.cjs",
  "author": "Local Holdem"
}
